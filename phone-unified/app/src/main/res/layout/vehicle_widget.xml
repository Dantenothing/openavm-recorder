<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_name_default" android:textSize="16sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:layout_weight="1" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minWidth="64dp" android:minHeight="24dp" android:gravity="center" android:layout_marginEnd="6dp" android:background="@drawable/widget_soft" android:contentDescription="打开极氪助手应用" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_refresh_default" android:textSize="12sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minHeight="28dp" android:gravity="center" android:drawableEnd="@drawable/ic_widget_refresh" android:drawablePadding="5dp" android:contentDescription="@string/widget_refresh_description" android:paddingStart="6dp" android:paddingEnd="4dp" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center_vertical" android:baselineAligned="false">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/widget_cabin_caption" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/widget_cabin_caption_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:baselineAligned="false">
<TextView android:id="@+id/widget_cabin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_cabin_default" android:textSize="38sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:textStyle="bold" android:minHeight="44dp" android:gravity="center_vertical" android:maxLines="1" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="14sp" android:autoSizeMaxTextSize="38sp" android:autoSizeStepGranularity="1sp" />
<ImageButton android:id="@+id/widget_temperature_update" android:layout_width="40dp" android:layout_height="match_parent" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_widget_refresh" android:background="@android:color/transparent" android:contentDescription="@string/widget_temperature_refresh_description" />
</LinearLayout>
            <TextView android:id="@+id/widget_thermal" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#52716A" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="2" android:ellipsize="end" android:layout_marginTop="2dp" />
            <TextView android:id="@+id/widget_energy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_energy_default" android:textSize="12sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:orientation="vertical" android:gravity="center">
            <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
                <ImageView android:id="@+id/widget_ambient" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
                <ImageView android:id="@+id/widget_car" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/zeekr_7x_default" android:scaleType="fitCenter" android:contentDescription="@string/widget_car_description" />
                <ImageView android:id="@+id/widget_airflow" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" android:importantForAccessibility="no" android:visibility="gone" />
            </FrameLayout>
            <TextView android:id="@+id/widget_climate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_climate_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:gravity="center" android:maxLines="1" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="30dp" android:gravity="center_vertical" android:baselineAligned="false">
        <TextView android:id="@+id/widget_source" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_source_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minHeight="20dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" />

    </LinearLayout>
    <ProgressBar android:id="@+id/widget_temperature_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:visibility="gone" android:indeterminateTint="#436F6D" />
    <TextView android:id="@+id/widget_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_location_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minHeight="26dp" android:gravity="center_vertical" android:maxLines="1" android:ellipsize="end" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="50dp" android:baselineAligned="false">
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="6dp">
            <TextView android:id="@+id/widget_prepare" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_control_idle" android:paddingStart="10dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_widget_temp" android:drawablePadding="7dp" android:text="@string/widget_prepare_default" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textColor="#203532" android:fontFamily="sans-serif-medium" />
            <ProgressBar android:id="@+id/widget_prepare_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="3dp" android:indeterminate="true" android:indeterminateTint="#C7DDD1" android:visibility="gone" />
        </FrameLayout>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="0dp">
            <TextView android:id="@+id/widget_find" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/widget_control_idle" android:paddingStart="10dp" android:paddingEnd="8dp" android:gravity="center_vertical" android:drawableStart="@drawable/ic_widget_horn" android:drawablePadding="7dp" android:text="@string/widget_find_default" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" android:textColor="#203532" android:fontFamily="sans-serif-medium" />
        </FrameLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:paddingTop="6dp" android:baselineAligned="false">
        <TextView android:id="@+id/widget_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/widget_control_idle" android:gravity="center" android:drawableTop="@drawable/ic_widget_lock" android:drawablePadding="3dp" android:paddingTop="2dp" android:paddingBottom="1dp" android:text="@string/widget_lock_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_guard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/widget_control_idle" android:gravity="center" android:drawableTop="@drawable/ic_widget_shield" android:drawablePadding="3dp" android:paddingTop="2dp" android:paddingBottom="1dp" android:text="@string/widget_guard_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_trunk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="5dp" android:background="@drawable/widget_control_idle" android:gravity="center" android:drawableTop="@drawable/ic_widget_trunk" android:drawablePadding="3dp" android:paddingTop="2dp" android:paddingBottom="1dp" android:text="@string/widget_trunk_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
        <TextView android:id="@+id/widget_port" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:layout_marginEnd="0dp" android:background="@drawable/widget_control_idle" android:gravity="center" android:drawableTop="@drawable/ic_widget_port" android:drawablePadding="3dp" android:paddingTop="2dp" android:paddingBottom="1dp" android:text="@string/widget_port_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:maxLines="1" android:ellipsize="end" android:autoSizeTextType="uniform" android:autoSizeMinTextSize="8sp" android:autoSizeMaxTextSize="11sp" android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
    <TextView android:id="@+id/widget_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_message_default" android:textSize="10sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minHeight="22dp" android:gravity="center_vertical" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
