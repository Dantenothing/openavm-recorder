<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp" android:background="@drawable/widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_name_default" android:textSize="12sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_open_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minWidth="64dp" android:minHeight="24dp" android:gravity="center" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/widget_energy" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_energy_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:maxLines="1" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_refresh_default" android:textSize="11sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:minWidth="44dp" android:minHeight="24dp" android:gravity="center" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
        <LinearLayout android:layout_width="132dp" android:layout_height="24dp" android:gravity="center_vertical" android:baselineAligned="false">
<TextView android:id="@+id/widget_cabin" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/widget_cabin_default" android:textSize="18sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false"  android:textStyle="bold" />
<ImageButton android:id="@+id/widget_temperature_update" android:layout_width="40dp" android:layout_height="match_parent" android:padding="8dp" android:scaleType="centerInside" android:src="@drawable/ic_widget_refresh" android:background="@android:color/transparent" android:contentDescription="@string/widget_temperature_refresh_description" />
</LinearLayout>

        <TextView android:id="@+id/widget_location" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_location_default" android:textSize="10sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="44dp" android:baselineAligned="false">
        <TextView android:id="@+id/widget_prepare" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_prepare" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
        <TextView android:id="@+id/widget_find" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_find" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
        <TextView android:id="@+id/widget_lock" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_lock" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
        <TextView android:id="@+id/widget_guard" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_guard" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
        <TextView android:id="@+id/widget_trunk" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="2dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_trunk" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
        <TextView android:id="@+id/widget_port" android:layout_width="0dp" android:layout_weight="1" android:layout_height="44dp" android:layout_marginEnd="0dp" android:gravity="center" android:maxLines="1" android:text="@string/strip_port" android:textSize="11sp" android:textColor="#203532" android:background="@drawable/widget_control_idle" />
    </LinearLayout>
    <ProgressBar android:id="@+id/widget_temperature_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="2dp" android:indeterminate="true" android:visibility="gone" android:indeterminateTint="#436F6D" />
    <TextView android:id="@+id/widget_source" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_source_default" android:textSize="10sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:visibility="gone" />
    <TextView android:id="@+id/widget_climate" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_climate_default" android:textSize="10sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:visibility="gone" />
    <TextView android:id="@+id/widget_message" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/widget_message_default" android:textSize="10sp" android:textColor="#203532" android:fontFamily="sans-serif" android:includeFontPadding="false" android:visibility="gone" />
    <ImageView android:id="@+id/widget_car" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" />
</LinearLayout>
